# 飞书（lark-cli 已登录后从 wiki URL / node 列表里取）
FEISHU_SPACE_ID=
FEISHU_PARENT_TOKEN=
FEISHU_OPEN_ID=
FEISHU_CHAT_ID=

# 本地 OpenAI 兼容网关
LLM_BASE_URL=http://127.0.0.1:8317/v1
LLM_MODEL=gpt-6-astra
LLM_MAX_ATTEMPTS=4
LLM_BACKOFF_SECONDS=3

# Hermes 安装位置（一般不用改）
HERMES_SCRIPTS=$HOME/.hermes/scripts
HERMES_WORKDIR=$HOME
